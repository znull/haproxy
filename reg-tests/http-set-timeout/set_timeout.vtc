client c22 -connect ${hap_li12_sock} {
    txreq
    rxresp
    expect resp.status == 200
} -start

client c23 -connect ${hap_li12_sock} {
    delay 0.2
    txreq
    rxresp
    expect resp.status == 503
} -run

client c22 -wait

syslog Slog1 -wait
syslog Slog2 -wait
syslog Slog3 -wait
syslog Slog4 -wait
syslog Slog5 -wait
syslog Slog6 -wait
syslog Slog7 -wait
syslog Slog8 -wait
syslog Slog9 -wait
