    recv
    expect ~ "^.*timeout: 5000 5000.*$"
} -start

syslog Slog7 -level info {
    recv
    expect ~ "^.*timeout: 5000 5000.*$"
} -start

syslog Slog8 -level info {
    recv
    expect ~ "^.*timeout: 5000 3000.*$"
} -start

syslog Slog9 -level info {
    recv
    expect ~ "^.*timeout: 5000 3000.*$"
} -start

syslog Slog10 -level info {
    recv
    expect ~ "^.*timeout: 5000 5000.*$"
} -start

syslog Slog11 -level info {
    recv
    expect ~ "^.*timeout: 5000 3000.*$"
} -start

syslog Slog12 -level info {
    recv
    expect ~ "^.*timeout: 5000 5000.*$"
} -start

syslog Slog13 -level info {
    recv
    expect ~ "^.*timeout: 5000 3000.*$"
} -start

syslog Slog14 -level info {
    recv
    expect ~ "^.*timeout: 0 3000.*$"
} -start

syslog Slog15 -level info {
    recv
    expect ~ "^.*timeout: 0 3000.*$"
} -start

syslog Slog16 -level info {
    recv
    expect ~ "^.*timeout: 2000 2000.*$"
} -start

syslog Slog17 -level info {
    recv
    expect ~ "^.*timeout: 2000 3000.*$"
} -start

syslog Slog18 -level info {
    recv
    expect ~ "^.*timeout: 2000 2000.*$"
} -start

syslog Slog19 -level info {
    recv
    expect ~ "^.*timeout: 2000 3000.*$"
} -start

syslog Slog20 -level info {
    recv
    expect ~ "^.*timeout: 0 3000.*$"
} -start

syslog Slog21 -level info {
    recv
    expect ~ "^.*timeout: 0 3000.*$"
} -start

syslog Slog22 -level info {
    recv
    expect ~ "^.*timeout: 2000 150.*$"
    recv
    expect ~ "^.*timeout: 2000 150.*$"
} -start

haproxy hap -conf {
    global
    .if feature(THREAD)
        thread-groups 1
    .endif

    defaults no_connect_timeout
        timeout client 5s
        timeout server 5s

    defaults
        timeout connect 5s
        timeout client 5s
        timeout server 5s
        timeout queue 2s

    listen li1
        mode http
        bind "fd@${li1}"
        log-format "timeout: %[be_server_timeout] %[cur_server_timeout]"
        log ${Slog1_addr}:${Slog1_port} len 2048 local0 debug err
        server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    listen li2
        mode http
        bind "fd@${li2}"
        log-format "timeout: %[be_server_timeout] %[cur_server_timeout]"
        log ${Slog2_addr}:${Slog2_port} len 2048 local0 debug err
        http-request set-timeout server 5s
       server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    listen li3
        mode http
        bind "fd@${li3}"
        log-format "timeout: %[fe_client_timeout] %[cur_client_timeout]"
        log ${Slog4_addr}:${Slog4_port} len 2048 local0 debug err
        http-request set-timeout client 5s
       server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    frontend fe1
        mode http
        bind "fd@${fe1}"
        log-format "timeout: %[be_server_timeout] %[cur_server_timeout]"
        log ${Slog3_addr}:${Slog3_port} len 2048 local0 debug err
        default_backend be1

    backend be1
       mode http
       http-request set-timeout server int(3),mul(1000)
       server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    frontend fe2
        mode http
        bind "fd@${fe2}"
        log-format "timeout: %[fe_client_timeout] %[cur_client_timeout]"
        log ${Slog5_addr}:${Slog5_port} len 2048 local0 debug err
        http-request set-timeout client int(3),mul(1000)
        default_backend be2

    backend be2
       mode http
       server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    listen li4
        mode http
        bind "fd@${li4}"
        log-format "timeout: %[be_server_timeout] %[cur_server_timeout]"
        log ${Slog6_addr}:${Slog6_port} len 2048 local0 debug err
        http-response set-timeout server 5s
       server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    listen li5
        mode http
        bind "fd@${li5}"
        log-format "timeout: %[fe_client_timeout] %[cur_client_timeout]"
        log ${Slog7_addr}:${Slog7_port} len 2048 local0 debug err
        http-response set-timeout client 5s
       server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    frontend fe3
        mode http
        bind "fd@${fe3}"
        log-format "timeout: %[be_server_timeout] %[cur_server_timeout]"
        log ${Slog8_addr}:${Slog8_port} len 2048 local0 debug err
        default_backend be1

    backend be3
       mode http
       http-response set-timeout server int(3),mul(1000)
       server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    frontend fe4
        mode http
        bind "fd@${fe4}"
        log-format "timeout: %[fe_client_timeout] %[cur_client_timeout]"
        log ${Slog9_addr}:${Slog9_port} len 2048 local0 debug err
        http-response set-timeout client int(3),mul(1000)
        default_backend be2

    backend be4
       mode http
       server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    frontend fe5
        mode http
        bind "fd@${fe5}"
        log-format "timeout: %[be_connect_timeout] %[cur_connect_timeout]"
        log ${Slog10_addr}:${Slog10_port} len 2048 local0 debug err
        default_backend be5

    backend be5
        mode http
        server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    frontend fe6
        mode http
        bind "fd@${fe6}"
        log-format "timeout: %[be_connect_timeout] %[cur_connect_timeout]"
        log ${Slog11_addr}:${Slog11_port} len 2048 local0 debug err
        default_backend be6

    backend be6
        mode http
        http-request set-timeout connect int(3),mul(1000)
        server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    listen li6
        mode http
        bind "fd@${li6}"
        log-format "timeout: %[be_connect_timeout] %[cur_connect_timeout]"
        log ${Slog12_addr}:${Slog12_port} len 2048 local0 debug err
        server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    listen li7
        mode http
        bind "fd@${li7}"
        log-format "timeout: %[be_connect_timeout] %[cur_connect_timeout]"
        log ${Slog13_addr}:${Slog13_port} len 2048 local0 debug err
        http-request set-timeout connect 3s
        server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    frontend fe7 from no_connect_timeout
        mode http
        bind "fd@${fe7}"
        log-format "timeout: %[be_connect_timeout] %[cur_connect_timeout]"
        log ${Slog14_addr}:${Slog14_port} len 2048 local0 debug err
        default_backend be7

    backend be7 from no_connect_timeout
        mode http
        http-request set-timeout connect int(3),mul(1000)
        server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    listen li8 from no_connect_timeout
        mode http
        bind "fd@${li8}"
        log-format "timeout: %[be_connect_timeout] %[cur_connect_timeout]"
        log ${Slog15_addr}:${Slog15_port} len 2048 local0 debug err
        http-request set-timeout connect 3s
        server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    frontend fe8
        mode http
        bind "fd@${fe8}"
        log-format "timeout: %[be_queue_timeout] %[cur_queue_timeout]"
        log ${Slog16_addr}:${Slog16_port} len 2048 local0 debug err
        default_backend be8

    backend be8
        mode http
        server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    frontend fe9
        mode http
        bind "fd@${fe9}"
        log-format "timeout: %[be_queue_timeout] %[cur_queue_timeout]"
        log ${Slog17_addr}:${Slog17_port} len 2048 local0 debug err
        default_backend be9

    backend be9
        mode http
        http-request set-timeout queue int(3),mul(1000)
        server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    listen li9
        mode http
        bind "fd@${li9}"
        log-format "timeout: %[be_queue_timeout] %[cur_queue_timeout]"
        log ${Slog18_addr}:${Slog18_port} len 2048 local0 debug err
        server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    listen li10
        mode http
        bind "fd@${li10}"
        log-format "timeout: %[be_queue_timeout] %[cur_queue_timeout]"
        log ${Slog19_addr}:${Slog19_port} len 2048 local0 debug err
        http-request set-timeout queue 3s
        server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    frontend fe10 from no_connect_timeout
        mode http
        bind "fd@${fe10}"
        log-format "timeout: %[be_queue_timeout] %[cur_queue_timeout]"
        log ${Slog20_addr}:${Slog20_port} len 2048 local0 debug err
        default_backend be10

    backend be10 from no_connect_timeout
        mode http
        http-request set-timeout queue int(3),mul(1000)
        server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    listen li11 from no_connect_timeout
        mode http
        bind "fd@${li11}"
        log-format "timeout: %[be_queue_timeout] %[cur_queue_timeout]"
        log ${Slog21_addr}:${Slog21_port} len 2048 local0 debug err
        http-request set-timeout queue 3s
        server srv_h1 ${srv_h1_addr}:${srv_h1_port}

    listen li12
        mode http
        bind "fd@${li12}"
        log-format "timeout: %[be_queue_timeout] %[cur_queue_timeout]"
        log ${Slog22_addr}:${Slog22_port} len 2048 local0 debug err
        http-request set-timeout queue 150
        server srv_h2 ${srv_h2_addr}:${srv_h2_port} maxconn 1
} -start

client c1 -connect ${hap_li1_sock} {
    txreq
    rxresp
    expect resp.status == 200
} -run

client c2 -connect ${hap_li2_sock} {
    txreq
    rxresp
    expect resp.status == 200
} -run

client c3 -connect ${hap_fe1_sock} {
    txreq
    rxresp
    expect resp.status == 200
} -run

